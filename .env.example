# PayCrow Configuration

# Agent wallet private key (Base Sepolia testnet only for v1)
PRIVATE_KEY=0x...

# Base Sepolia RPC URL
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployed PayCrowEscrow contract address (set after deployment)
ESCROW_CONTRACT_ADDRESS=0x...

# Treasury address (receives protocol fees)
TREASURY_ADDRESS=0x...

# Arbiter address (resolves disputes)
ARBITER_ADDRESS=0x...

# PostgreSQL connection (for trust scores, v2)
DATABASE_URL=postgresql://localhost:5432/paycrow

# Optional: Coinbase CDP API key (for faucet access)
CDP_API_KEY=
CDP_API_SECRET=

# ───────────── AgentPay (Avalanche Fuji) ─────────────
# Fill the keys with your own Fuji test wallets (never real funds). Public values are prefilled.
FUJI_CHAIN_ID=43113
FUJI_RPC_URL_1=https://avalanche-fuji-c-chain-rpc.publicnode.com
FUJI_RPC_URL_2=https://api.avax-test.network/ext/bc/C/rpc
AVAX_MAINNET_RPC_URL_1=https://avalanche-c-chain-rpc.publicnode.com
AVAX_MAINNET_RPC_URL_2=https://api.avax.network/ext/bc/C/rpc
AGENTPAY_ESCROW=0xEbBE6E2cCE97a6C2Cb93563936b5846481C942ac
USDC_FUJI=0x5425890298aed601595a70AB815c96711a31Bc65
VERIFIER_ADDRESS=0x7C06cef00c06455a7d0Dd91A10732b46F9Ea1FAA
VERIFIER_URL=https://agentpay-verifier.fly.dev/v1
FACILITATOR_URL=https://agentpay-facilitator.fly.dev
SCORER_URL=https://agentpay-scorer.fly.dev
SELLER_URL=https://agentpay-seller.fly.dev/v1/price/AVAX
LOW_SCORE_SELLER_URL=https://agentpay-low-seller.fly.dev/v1/price/AVAX
SELLER_AGENT_ID=306
# Buyer wallets (auto mode uses BUYER_AUTO_*; approve mode uses your MetaMask address)
BUYER_AUTO_PRIVATE_KEY=0x...
BUYER_MAIN_ADDRESS=0x...
# Only when running your own services instead of the hosted ones above
VERIFIER_PRIVATE_KEY=0x...
VERIFIER_BODY_KEY=
FACILITATOR_PRIVATE_KEY=0x...
SCORER_PRIVATE_KEY=0x...
KEEPER_PRIVATE_KEY=0x...
SELLER_PRIVATE_KEY=0x...
DEMO_FAULT_TOKEN=
# Optional Scorer source: Base USDC history via Alchemy (https://base-mainnet.g.alchemy.com/v2/<key>)
ALCHEMY_BASE_URL=
