{
  "name": "@agentpay-demo/seller-avax-price",
  "version": "0.2.0",
  "private": true,
  "description": "Demo seller: AVAX price API with a fault switch (20% deviation) (owner: C)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
