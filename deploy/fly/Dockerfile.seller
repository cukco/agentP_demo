# Demo seller (demo/seller-avax-price, C) on Fly.io. Needs the Seller SDK and demo packages (c/sdk-lead).
FROM node:22-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@10.30.3 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/agentpay-core/ packages/agentpay-core/
COPY packages/agentpay-seller/ packages/agentpay-seller/
COPY demo/seller-avax-price/ demo/seller-avax-price/
RUN pnpm install --frozen-lockfile --filter @agentpay-demo/seller-avax-price...
RUN pnpm --filter @agentpay-demo/seller-avax-price... build
RUN pnpm --filter @agentpay-demo/seller-avax-price deploy --legacy --prod /out/seller
FROM node:22-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0
WORKDIR /services
COPY --from=build --chown=node:node /out/ ./
USER node
CMD ["node", "seller/dist/index.js"]
